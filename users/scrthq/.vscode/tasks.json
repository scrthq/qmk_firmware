{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile QMK Firmware",
            "type": "shell",
            "command": "start=$(date +'%F %T') && export QMK_HOME=\"/Users/nferrell/ScrtGit/qmk_firmware\" && cd ${QMK_HOME} && qmk compile -kb ${input:Keyboard} -km ${input:Keymap} && echo \"\" && echo \"Start : $start\" && echo \"End   : $(date +'%F %T')\"",
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 2
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false,
                "group": "QMK",
            },
            "options": {
                "shell": {
                    "args": [
                        "--login",
                        "-c"
                    ],
                    "executable": "zsh"
                },
            }
        },
        {
            "label": "(Mun) Compile QMK Firmware (Windows)",
            "type": "shell",
            "command": "start=$(date +'%F %T') && export QMK_HOME=\"/Users/nferrell/ScrtGit/qmk_firmware_rgbkb\" && cd ${QMK_HOME} && qmk compile -kb rgbkb/mun -km ${input:Keymap} && echo \"\" && echo \"Start : $start\" && echo \"End   : $(date +'%F %T')\"",
            "problemMatcher": [],
