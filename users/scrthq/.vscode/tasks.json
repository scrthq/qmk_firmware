    "inputs": [
        {
            "id": "QMK_HOME",
            "description": "QMK_HOME:",
            "default": "/Users/nferrell/ScrtGit/qmk_firmware",
            "type": "pickString",
            "options": [
                "/Users/nferrell/ScrtGit/qmk_firmware",
                "/Users/nferrell/ScrtGit/qmk_firmware_rgbkb",
            ]
        },
        {
            "id": "Action",
