                "instanceLimit": 2
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false,
                "group": "QMK",
            },
            "options": {
                "shell": {
                    "args": [
                        "--login",
                        "-c"
                    ],
                    "executable": "zsh"
                },
            }
        },
